{
  "name": "@deepseek-ai/dsh-codex-native-compaction",
  "description": "Codex Responses native compaction provider for DeepSeek Harness",
  "version": "0.1.2-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
